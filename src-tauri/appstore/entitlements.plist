<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- WKWebView's processes need this even for the app's bundled UI: without it the
	     windows stay blank (verified). Hourmint itself makes no network requests. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Save PDFs/CSVs, export folders, pick a logo, restore a backup: only files the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
