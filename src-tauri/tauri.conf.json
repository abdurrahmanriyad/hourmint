{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hourmint",
  "version": "../package.json",
  "identifier": "app.hourmint.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hourmint",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Time tracking and invoices for freelancers",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRTE4NDhBNjU0Njc2MzQKUldRMGRrWmxpb1RoejhXZDVTWU1KQ1lOK21yTTk1aGlpajBJdURpRldHQUYzWDBXSEFZWi9GOEYK",
      "endpoints": [
        "https://github.com/abdurrahmanriyad/hourmint/releases/latest/download/latest.json"
      ]
    }
  }
}
